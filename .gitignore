!/package.json
!/publication/AUTOSTART-EN.md
!/publication/AUTOSTART-PT-BR.md
!/rpc/bridge.cjs
!/rpc/config.json
!/rpc/discord.cjs
!/rpc/locales.cjs
!/rpc/maps.cjs
!/rpc/presence.cjs
