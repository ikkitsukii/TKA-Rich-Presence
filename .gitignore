# Default deny: only reviewed source and documentation are publishable.
/*
!/docs/
/docs/*
!/publication/
/publication/*
!/rpc/
/rpc/*
!/scripts/
/scripts/*
!/tests/
/tests/*
!/TKA_RPC/
/TKA_RPC/*
!/TKA_RPC/Bridge/
/TKA_RPC/Bridge/*
!/TKA_RPC/Scripts/
/TKA_RPC/Scripts/*
!/.gitattributes
!/.gitignore
!/.node-version
!/CHANGELOG.md
!/LICENSE.txt
!/README.md
!/THIRD-PARTY-NOTICES.txt
!/TKA_RPC/Bridge/AutoStart.ps1
!/TKA_RPC/Scripts/AutoStart.lua
!/TKA_RPC/Scripts/Interactions.lua
!/TKA_RPC/Scripts/main.lua
!/TKA_RPC/enabled.txt
!/docs/BUILD.md
!/docs/DEPENDENCIES.md
!/docs/RELEASE-v0.4.0-beta.md
!/docs/SECURITY-REVIEW.md
!/docs/SOURCE-MANIFEST.md
